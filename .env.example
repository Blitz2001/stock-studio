# Copy to .env and fill in. Never commit .env.

# Which provider the QC + metadata agents use: gemini | claude | openai | offline
# "offline" runs only the technical checks and template metadata (no API calls).
LLM_PROVIDER=gemini

# --- Gemini (default; free tier works for QC + metadata) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Image generation for the ai_images lane. Imagen is a paid API feature;
# check Google's current terms for commercial use before selling outputs.
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# --- Claude (optional) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- OpenAI (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Duplicate guard embedder: clip (needs `pip install .[clip]`, CPU is fine) | phash (no extra deps)
EMBEDDER=clip
